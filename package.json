{
  "name": "@bjorvack/lorcana-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Cards + tournaments scraper for the Lorcana deckbuilder pipeline.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lorcana-scrape": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "scrape": "tsx src/index.ts",
    "scrape:cards": "tsx src/cards/run.ts",
    "scrape:tournaments": "tsx src/tournaments/cli.ts",
    "scrape:banlist": "tsx src/legality/run.ts --mode banlist",
    "scrape:rotation": "tsx src/legality/run.ts --mode rotation",
    "scrape:legality": "tsx src/legality/run.ts --mode both",
    "tournaments:validate": "tsx src/tournaments/validate.ts",
    "tournaments:merge-shards": "tsx src/tournaments/merge-shards.ts",
    "tournaments:promote": "tsx src/tournaments/promote.ts",
    "tournaments:unresolved": "tsx src/tournaments/unresolved.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bjorvack/lorcana-schemas": "^0.7.0",
    "cheerio": "^1.0.0",
    "pino": "^9.4.0",
    "playwright": "^1.47.0",
    "playwright-core": "^1.60.0",
    "undici": "^6.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.0",
    "tsup": "^8.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.1"
}
